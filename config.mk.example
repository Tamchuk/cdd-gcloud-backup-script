# Copy to config.mk (and keep it out of git) then fill in your values.
REGION       = europe-west1
BUCKET_NAME  = my-project-cdd-backup-test
CDD_VAULT_ID = 1234
EXPORTS      = molecules
# PROJECT_ID defaults to `gcloud config get-value project`
# Optional: weekly schedule (cron, in TIME_ZONE) and alert email
SCHEDULE     = 0 2 * * 0
TIME_ZONE    = Asia/Jerusalem
ALERT_EMAIL  = you@example.com
